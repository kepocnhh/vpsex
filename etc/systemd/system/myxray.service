[Unit]
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=28800
StartLimitBurst=512

[Service]
Type=simple
User=nobody
Group=xray
ExecStart=/usr/local/bin/xray run -c /usr/local/etc/xray/config.json
Restart=on-failure
RestartSec=32
RuntimeMaxSec=28800

[Install]
WantedBy=multi-user.target
