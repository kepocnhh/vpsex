foo.org, www.foo.org {
    root * /var/www/foo.org

    @allowed {
        path /
        path /index.html
        path /src/*
    }

    handle @allowed {
        encode gzip
        file_server
    }

    handle {
        respond 404
    }

    reverse_proxy /${GRPC_SECRET}/* 127.0.0.1:10001 {
        transport http {
            versions h2c
        }
    }
}
