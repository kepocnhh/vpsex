foo.org, www.foo.org {
    root * /var/www/foo.org

    @is_grpc {
        path /{env.GRPC_SECRET}/*
        protocol grpc
    }

    handle @is_grpc {
        reverse_proxy 127.0.0.1:10001 {
            transport http {
                versions h2c
            }
        }
    }

    @allowed {
        path /
        path /index.html
        path /src/*
    }

    handle @allowed {
        encode gzip
        file_server
    }

    handle {
        respond 404
    }
}
